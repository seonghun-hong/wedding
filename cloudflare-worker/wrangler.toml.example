name = "wedding-photo-upload"
main = "src/index.js"
compatibility_date = "2026-07-01"

[vars]
# Origin only. Do not include the /wedding path.
ALLOWED_ORIGINS = "https://seonghun-hong.github.io,http://localhost:5173,http://127.0.0.1:5173"
MAX_FILE_BYTES = "31457280"
MAX_STORAGE_BYTES = "13958643712"

# Add these with `wrangler secret put`, never in this file:
# GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_SECRET
# GOOGLE_REFRESH_TOKEN
# GOOGLE_DRIVE_ORIGINALS_FOLDER_ID
# GOOGLE_DRIVE_THUMBNAILS_FOLDER_ID
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
